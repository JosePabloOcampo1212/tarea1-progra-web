<?xml version="1.0" encoding="utf-8"?>
<!--
  Sesión en proceso (InProc). Los préstamos viven en Session como List de Prestamo.
  No hay autenticación, base de datos ni archivos de persistencia.
-->
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="Static" />
    <authentication mode="None" />
    <sessionState mode="InProc" timeout="60" cookieless="false" />
    <globalization culture="es-CR" uiCulture="es-CR" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <customErrors mode="RemoteOnly" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
